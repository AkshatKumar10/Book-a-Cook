{
  "expo": {
    "name": "Book a Cook",
    "slug": "Book_a_Cook",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/bookacook.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bookacook.bookacook",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/bookacook.png",
        "backgroundColor": "#ffffff"
      },
      "versionCode":1,
      "package": "com.bookacook.bookacook"
    },
    "web": {
      "favicon": "./assets/bookacook.png"
    },
    "extra": {
      "eas": {
        "projectId": "bc11a537-c97b-493d-a972-acd60a54a5f5"
      }
    },
    "owner": "akshatk_07",
    "plugins": [
      "@react-native-community/datetimepicker",
      "expo-build-properties",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/bookacook.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-font"
    ]
  }
}
